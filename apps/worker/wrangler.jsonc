{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mirowler",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mirowler",
      "database_id": "26fc3682-60d2-4ebb-91d6-ad7a06714798",
      "migrations_dir": "migrations"
    }
  ]
}
