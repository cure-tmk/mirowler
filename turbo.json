{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck", "^types:api"]
    },
    "types:api": {
      "dependsOn": ["typecheck"],
      "outputs": ["dist/api/**"]
    },
    "test": {
      "dependsOn": ["^typecheck"]
    },
    "build": {
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["@mirowler/web#build"],
      "cache": false,
      "persistent": true
    }
  }
}
